# Database (Neon Postgres)
# App runtime uses the POOLED endpoint (Neon `-pooler` host) so serverless
# cold-start bursts hit PgBouncer, not Postgres directly.
DATABASE_URL=postgres://user:password@host-pooler/db?sslmode=require
# DIRECT (unpooled) endpoint — used ONLY by migrations (scripts/maybe-migrate.ts),
# which need session-level features PgBouncer transaction pooling lacks. Set on
# Vercel Production + Preview. Falls back to DATABASE_URL locally if unset.
DATABASE_URL_UNPOOLED=postgres://user:password@host/db?sslmode=require

# Payload
PAYLOAD_SECRET=change-me-to-a-64-char-random-string
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Drizzle push-mode: only set 'true' for fast local-dev iteration when you don't
# want to generate a migration for every schema poke. CI and production both
# run `pnpm payload:migrate` and IGNORE this flag (Vercel runs in
# NODE_ENV=production where Drizzle blocks push entirely — set it on prod and
# you'll silently ship a schema mismatch, which broke /api/users/login on
# 2026-05-16). Default: false. See README "Schema changes" for the workflow.
PAYLOAD_DB_PUSH=false

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 (S3-compatible) — fill in once buckets exist
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=marialeviphoto-media
R2_PUBLIC_URL=
# Object-key namespace for the shared bucket: "dev" on dev, "preview" on preview,
# leave EMPTY on prod (root). Stored per-upload so existing root files keep
# resolving. Prevents dev/prod filename collisions on the shared bucket.
R2_PREFIX=

# Cloudflare Images — fill in once enabled
CLOUDFLARE_IMAGES_ACCOUNT=
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_IMAGES_HASH=

# Email (Resend) — fill in after domain verified
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@marialeviphoto.com
RESEND_REPLY_TO=hello@marialeviphoto.com

# Email marketing (Flodesk)
FLODESK_API_KEY=
FLODESK_FALLBACK_ZAPIER_URL=

# Analytics (loaded only after cookie consent)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_PIXEL_ID=

# Sentry — fill in once project exists
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Webhook secrets (generate random values)
REVALIDATE_SECRET=
PAYLOAD_WEBHOOK_SECRET=
LEAD_WEBHOOK_SECRET=

# Lead magnet — HMAC secret for signing PDF download tokens. Falls back to
# PAYLOAD_SECRET if unset, but a dedicated value is recommended in prod.
LEAD_MAGNET_TOKEN_SECRET=

# Future (CRM)
HONEYBOOK_API_KEY=
